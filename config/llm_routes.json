{
  "version": 1,
  "provider": "gemini",
  "api": {"transport": "generateContent", "base_url": "https://generativelanguage.googleapis.com/v1beta", "structured_output": "responseFormat"},
  "models": {
    "standard": {"model": "gemini-3.8-flash", "stable": true, "enabled": true},
    "deep": {"model": "gemini-2.5-pro", "stable": true, "enabled": true}
  },
  "tasks": {
    "market.narrative": {
      "route": "standard", "fallback": "deep", "temperature": 0.2, "max_output_tokens": 2200,
      "output_schema": "schemas/llm/market_narrative_v1.json",
      "enabled": true, "output_schema_version": "market-narrative.v1"
    }
  },
  "source_of_truth": "repository_config"
}