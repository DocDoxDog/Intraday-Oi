# QuikStrike page URL — session id (qsid) may expire, refresh manually as needed
QUIKSTRIKE_URL=https://cmegroup-tools.quikstrike.net/User/QuikStrikeView.aspx?pid=40&pf=6&viewitemid=IntegratedV2VExpectedRange&insid=233550200&qsid=REPLACE_ME

# Supabase (project: OI-intraday)
SUPABASE_URL=https://mwqmxxipgdhbcmwoqueg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Gemini API — existing key; Intraday-Oi contains the supaBOT-compatible router, verifier, schema and telemetry locally
GEMINI_API_KEY=REPLACE_ME
SUPABOT_LLM_TIMEOUT_SECONDS=60

# Telegram (ใช้ bot เดิมของ QontWise ก็ได้ หรือสร้างใหม่แยก)
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# LINE Official Account — Messaging API channel access token (long-lived)
# เอาได้จาก LINE Developers Console > ช่อง Messaging API ของ OA > Channel access token
# ใช้ Broadcast API ส่งหาทุกคนที่แอดเพื่อน OA ทีเดียว ไม่ต้องมี userId รายคน
LINE_CHANNEL_ACCESS_TOKEN=REPLACE_ME
# LINE group ID ที่ต้องการรับรายงานซ้ำจาก Broadcast
LINE_GROUP_ID=Cb4b577135e632e661d42065393755094

# Twelve Data XAU/USD spot basis
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL=XAU/USD


# Gold Market Intelligence engines
ENABLE_FRED_MACRO=1
# Optional FRED API key; public FRED CSV fallback works without it.
FRED_API_KEY=
AUCTION_BIN_SIZE=0.5
AUCTION_VALUE_AREA_PCT=0.70
ORDER_FLOW_ABSORPTION_MAX_DISPLACEMENT=0.5
ORDER_FLOW_ABSORPTION_MIN_TRADES=5
MIN_RR1=1.0
MAX_STOP_ATR_MULTIPLE=3.0
