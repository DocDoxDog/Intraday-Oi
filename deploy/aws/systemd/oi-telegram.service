[Unit]
Description=OI Market Intelligence Telegram Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oi
WorkingDirectory=/opt/oi-market-intelligence
EnvironmentFile=/etc/oi-market-intelligence/env
ExecStart=/usr/bin/python3 -m workers.telegram
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
